posecode stretch "Estiramiento de hombro"
  rig humanoid
  pose start = neutral

  step "Inclinación" 1.0s settle:
    shoulders: flex 40
    cue "Incliná el hombro hacia atrás, sin apurar"

  step "Retorno" 1.5s settle:
    shoulders: flex 0
    cue "Volvé a la posición inicial despacio"

  repeat 3
