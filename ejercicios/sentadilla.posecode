posecode exercise "Sentadilla"
  rig humanoid
  pose start = standing

  step "Bajar" 1.6s settle:
    hips: flex 80
    knees: flex 95
    ankles: dorsiflex 15
    pelvis: hinge 25
    spine: flex 0
    shoulders: flex 70
    ground-lock: feet
    cue "Llevá la cadera hacia atrás, pecho erguido"

  step "Subir" 1.2s drive:
    hips: flex 0
    knees: flex 0
    ankles: plantarflex 0
    pelvis: hinge 0
    shoulders: flex 0
    ground-lock: feet
    cue "Empujá con los talones hasta quedar parado"

  repeat 8
