posecode exercise "Remo inclinado"
  rig humanoid
  pose start = standing

  step "Inclinar la cadera" 1.6s flow:
    pelvis: hinge 70
    knees: flex 20
    ankles: dorsiflex 5
    shoulders: flex 65
    elbows: flex 10
    elbows: pronate 80
    neck: extend 12
    ground-lock: feet
    cue "Incliná el torso hasta que la espalda quede recta, dejá que los brazos cuelguen rectos"

  step "Remar" 0.9s settle:
    shoulders: extend 10
    elbows: flex 95
    elbows: pronate 80
    ground-lock: feet
    cue "Llevá los codos hacia arriba pasando las costillas, apretá los omóplatos"

  step "Bajar" 1s settle:
    shoulders: flex 65
    elbows: flex 10
    elbows: pronate 80
    ground-lock: feet
    cue "Bajá la barra con control, mantené la espalda recta"

  step "Pararse" 1s settle:
    pelvis: hinge 0
    knees: flex 0
    ankles: dorsiflex 0
    shoulders: flex 0
    elbows: flex 0
    elbows: pronate 80
    neck: extend 0
    ground-lock: feet
    cue "Pará erguido entre series"

  repeat 8
